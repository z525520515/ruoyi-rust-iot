#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub enum ParamType {
    /// 清零
    Clear(AlarmValue),
    /// 第一传感器高报警
    HighAlarm(AlarmValue),
    /// 第一传感器低报警
    LowAlarm(AlarmValue),
    /// 数据记录间隔
    RecordInterval(AlarmValue),
    /// 上传间隔
    UploadInterval(AlarmValue),
    /// 设置 IP 地址
    IpAddress(AlarmValue),
    /// 设置端口号
    Port(AlarmValue_2),
    /// 设置采集间隔
    SamplingInterval(AlarmValue),
    /// 设置波动报警
    WaveAlarm(AlarmValue),
    /// 设置第二传感器的高报警
    HighAlarmTwo(AlarmValue),
    /// 设置第二传感器的低报警
    LowAlarmTwo(AlarmValue),
    /// 设置第二传感器的波动报警
    WaveAlarmTwo(AlarmValue),
    /// 设置第二传感器的记录间隔
    RecordIntervalTwo(AlarmValue),
    /// 复位
    Reset(AlarmValue),
    /// 用户自定义字符串
    UserString(CustomString),
    /// 电接点设置
    ContactPoint(RelayControl),
}

impl ParamType {
    pub fn from_alarm_value(value: AlarmValue, type_num: u8) -> ParseResult<Self> {
        match type_num {
            1 => Ok(ParamType::Clear(value)),
            2 => Ok(ParamType::HighAlarm(value)),
            3 => Ok(ParamType::LowAlarm(value)),
            4 => Ok(ParamType::RecordInterval(value)),
            5 => Ok(ParamType::UploadInterval(value)),
            11 => Ok(ParamType::IpAddress(value)),
            13 => Ok(ParamType::SamplingInterval(value)),
            14 => Ok(ParamType::WaveAlarm(value)),
            15 => Ok(ParamType::HighAlarmTwo(value)),
            16 => Ok(ParamType::LowAlarmTwo(value)),
            17 => Ok(ParamType::WaveAlarmTwo(value)),
            18 => Ok(ParamType::RecordIntervalTwo(value)),
            19 => Ok(ParamType::Reset(value)),
            _ => Err(ParseError::InvalidDataFormat {
                data_type: 0,
                reason: format!("Data type not supported: {type_num}"),
            }),
        }
    }

    pub fn get_type_num(&self) -> u8 {
        match self {
            ParamType::Clear(_) => 1,
            ParamType::HighAlarm(_) => 2,
            ParamType::LowAlarm(_) => 3,
            ParamType::RecordInterval(_) => 4,
            ParamType::UploadInterval(_) => 5,
            ParamType::IpAddress(_) => 11,
            ParamType::Port(_) => 12,
            ParamType::SamplingInterval(_) => 13,
            ParamType::WaveAlarm(_) => 14,
            ParamType::HighAlarmTwo(_) => 15,
            ParamType::LowAlarmTwo(_) => 16,
            ParamType::WaveAlarmTwo(_) => 17,
            ParamType::RecordIntervalTwo(_) => 18,
            ParamType::Reset(_) => 19,
            ParamType::UserString(_) => 20,
            ParamType::ContactPoint(_) => 33,
        }
    }

    fn to_bytes(&self) -> Vec<u8> {
        match self {
            ParamType::Clear(alarm_value) => alarm_value.to_bytes().to_vec(),
            ParamType::HighAlarm(alarm_value) => alarm_value.to_bytes().to_vec(),
            ParamType::LowAlarm(alarm_value) => alarm_value.to_bytes().to_vec(),
            ParamType::RecordInterval(interval) => interval.to_bytes().to_vec(),
            ParamType::UploadInterval(interval) => interval.to_bytes().to_vec(),
            ParamType::IpAddress(ip) => ip.to_bytes().to_vec(),
            ParamType::Port(port) => port.to_bytes().to_vec(),
            ParamType::SamplingInterval(interval) => interval.to_bytes().to_vec(),
            ParamType::WaveAlarm(alarm_value) => alarm_value.to_bytes().to_vec(),
            ParamType::HighAlarmTwo(alarm_value) => alarm_value.to_bytes().to_vec(),
            ParamType::LowAlarmTwo(alarm_value) => alarm_value.to_bytes().to_vec(),
            ParamType::WaveAlarmTwo(alarm_value) => alarm_value.to_bytes().to_vec(),
            ParamType::RecordIntervalTwo(interval) => interval.to_bytes().to_vec(),
            ParamType::Reset(reset_value) => reset_value.to_bytes().to_vec(),
            ParamType::UserString(string) => string.to_bytes().to_vec(),
            ParamType::ContactPoint(contact_point) => contact_point.to_bytes().to_vec(),
        }
    }
}

/// 参数设置单元
pub struct ParamSetUnit {
    pub item: ParamType,
    pub data_type: u8,
    pub data_len: u8,
}
