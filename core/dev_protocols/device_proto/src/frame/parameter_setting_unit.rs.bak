use super::error::{ParseError, ParseResult};
use crate::Codec;
use byteorder::{BigEndian, ReadBytesExt};
use serde::{Deserialize, Serialize};
use std::io::{Cursor, Read};

pub trait ToParamSetUnit {
    fn to_param_type(&self) -> ParamSetUnit;
}

/// 参数设置数据单元字节数
pub struct ParamSetUnitSize(u16);

impl ParamSetUnitSize {
    pub fn new(size: u16) -> ParamSetUnitSize {
        ParamSetUnitSize(size)
    }

    pub fn get_size(&self) -> u16 {
        self.0
    }

    fn from_bytes(bytes: &[u8]) -> ParseResult<Self> {
        if bytes.len() < 2 {
            Err(ParseError::InsufficientData {
                field: "ParamSetUnitSize".to_string(),
                expected: 2,
                actual: bytes.len(),
            })
        } else {
            Ok(ParamSetUnitSize::new(u16::from_be_bytes([
                bytes[0], bytes[1],
            ])))
        }
    }

    fn to_bytes(&self) -> [u8; 2] {
        self.get_size().to_be_bytes()
    }

    pub fn from_cursor_bytes(cursor: &mut Cursor<&[u8]>) -> ParseResult<Self> {
        cursor
            .read_u16::<BigEndian>()
            .map(ParamSetUnitSize::new)
            .map_err(|e| ParseError::InvalidDataFormat {
                data_type: 0,
                reason: format!("Failded to read parameter setting unit size: {}", e),
            })
    }
}

impl Codec<2> for ParamSetUnitSize {
    fn from_bytes(bytes: &[u8]) -> ParseResult<Self>
    where
        Self: Sized,
    {
        ParamSetUnitSize::from_bytes(bytes)
    }

    fn to_bytes_const(&self) -> [u8; 2] {
        ParamSetUnitSize::to_bytes(self)
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Deserialize, Serialize)]
pub struct AlarmValue {
    value: u32,
}

impl AlarmValue {
    pub fn from_lsp(value: u32) -> AlarmValue {
        AlarmValue { value }
    }

    pub fn get_raw_data(&self) -> u32 {
        self.value
    }

    fn from_bytes(bytes: &[u8]) -> ParseResult<Self> {
        if bytes.len() < 4 {
            Err(ParseError::InsufficientData {
                field: "AlarmValue".to_string(),
                expected: 4,
                actual: bytes.len(),
            })
        } else {
            Ok(AlarmValue::from_lsp(u32::from_be_bytes([
                bytes[0], bytes[1], bytes[2], bytes[3],
            ])))
        }
    }

    fn to_bytes(&self) -> [u8; 4] {
        self.value.to_be_bytes()
    }
}

impl Codec<4> for AlarmValue {
    fn from_bytes(bytes: &[u8]) -> ParseResult<Self>
    where
        Self: Sized,
    {
        AlarmValue::from_bytes(bytes)
    }

    fn to_bytes_const(&self) -> [u8; 4] {
        AlarmValue::to_bytes(self)
    }
}

/// 电接点行为
#[derive(Debug, Clone, Copy, PartialEq, Deserialize, Serialize)]
pub enum RelayMode {
    /// 常闭
    NormallyClosed,
    /// 闭合一段时间后断开
    Pulse { seconds: u16 },
}

impl RelayMode {
    pub fn set_pulse_duration(seconds: u16) -> Self {
        if seconds == 0 {
            RelayMode::NormallyClosed
        } else {
            RelayMode::Pulse { seconds }
        }
    }

    pub fn from_bytes(bytes: &[u8]) -> ParseResult<Self> {
        if bytes.len() < 2 {
            return Err(ParseError::InsufficientData {
                field: "RelayMode".to_string(),
                expected: 2,
                actual: bytes.len(),
            });
        }
        let raw_data = u16::from_be_bytes([bytes[0], bytes[1]]);
        match raw_data {
            0 => Ok(RelayMode::NormallyClosed),
            _ => Ok(RelayMode::Pulse { seconds: raw_data }),
        }
    }

    pub fn to_bytes(&self) -> [u8; 2] {
        match self {
            RelayMode::NormallyClosed => [0, 0],
            RelayMode::Pulse { seconds } => seconds.to_be_bytes(),
        }
    }
}

/// 输出位掩码
#[derive(Debug, Clone, Copy, PartialEq, Deserialize, Serialize)]
pub struct RelayMask(u16);

impl RelayMask {
    pub fn new() -> Self {
        RelayMask(0)
    }

    pub fn from_mask(mask: u16) -> Self {
        RelayMask(mask)
    }

    pub fn from_bit(n: u8) -> Self {
        RelayMask(1 << n)
    }

    pub fn from_bytes(bytes: &[u8]) -> ParseResult<Self> {
        if bytes.len() < 2 {
            Err(ParseError::InsufficientData {
                field: "RelayMask".to_string(),
                expected: 2,
                actual: bytes.len(),
            })
        } else {
            Ok(RelayMask(u16::from_be_bytes([bytes[0], bytes[1]])))
        }
    }

    pub fn get_mask(&self) -> u16 {
        self.0
    }

    pub fn set_bit(mut self, n: u8) -> Self {
        self.0 |= 1 << n;
        self
    }

    pub fn is_close_up(&self, idx: u8) -> bool {
        (self.0 & (1 << idx)) != 0
    }

    pub fn to_bytes(&self) -> [u8; 2] {
        self.0.to_be_bytes()
    }
}

/// 102 声光报警器只使用第 1 位，1 位报警开启，0 为关闭
#[derive(Debug, Clone, Copy, PartialEq, Deserialize, Serialize)]
pub struct RelayControl {
    pub mask: RelayMask,
    pub mode: RelayMode,
}

impl ToParamSetUnit for RelayControl {
    fn to_param_type(&self) -> ParamSetUnit {
        ParamSetUnit {
            item: ParamType::ContactPoint(self.clone()),
            data_type: 33,
            data_len: 4,
        }
    }
}

impl RelayControl {
    pub fn from_entry(mask: RelayMask, mode: RelayMode) -> Self {
        RelayControl { mask, mode }
    }

    pub fn from_cursor_bytes(cursor: &mut Cursor<&[u8]>) -> ParseResult<Self> {
        let remaining = cursor.get_ref().len() - cursor.position() as usize;
        if remaining < 4 {
            Err(ParseError::InsufficientData {
                field: "RelayControl".to_string(),
                expected: 4,
                actual: remaining,
            })
        } else {
            let mut raw_mask_data = [0u8; 2];
            cursor
                .read_exact(&mut raw_mask_data)
                .map_err(|e| ParseError::InvalidDataFormat {
                    data_type: 0,
                    reason: format!("Failed to read relay_mask: {e}"),
                })?;
            let mask = RelayMask::from_bytes(&raw_mask_data)?;
            let mode =
                RelayMode::set_pulse_duration(cursor.read_u16::<BigEndian>().map_err(|e| {
                    ParseError::InvalidDataFormat {
                        data_type: 0,
                        reason: format!("Failed to read relay_mode: {e}"),
                    }
                })?);
            Ok(RelayControl { mask, mode })
        }
    }

    /// 控制时间常闭状态，所有输出控制位断开
    pub fn new() -> Self {
        RelayControl::from_entry(RelayMask::new(), RelayMode::NormallyClosed)
    }

    pub fn set_close_up_duration(&self, ts_seconds: u16) -> Self {
        RelayControl::from_entry(RelayMask::new(), RelayMode::set_pulse_duration(ts_seconds))
    }

    pub fn set_mode(mut self, mode: RelayMode) -> Self {
        self.mode = mode;
        self
    }

    pub fn set_control_bit(mut self, bit: u8) -> Self {
        self.mask = self.mask.set_bit(bit);
        self
    }

    pub fn get_control_bits(&self) -> Vec<u8> {
        let mut bits = Vec::new();
        for i in 0..16 {
            if self.mask.is_close_up(i) {
                bits.push(i);
            }
        }
        bits
    }

    pub fn is_close_up(&self, idx: u8) -> bool {
        self.mask.is_close_up(idx)
    }

    pub fn get_mode(&self) -> RelayMode {
        self.mode
    }

    fn from_bytes(bytes: &[u8]) -> ParseResult<Self> {
        if bytes.len() < 4 {
            Err(ParseError::InsufficientData {
                field: "RelayControl".to_string(),
                expected: 4,
                actual: bytes.len(),
            })
        } else {
            let mask = RelayMask::from_bytes(&bytes[0..2])?;
            let mode = RelayMode::from_bytes(&bytes[2..4])?;
            Ok(RelayControl { mask, mode })
        }
    }

    pub fn to_bytes(&self) -> [u8; 4] {
        let mut bytes = [0; 4];
        bytes[0..2].copy_from_slice(&self.mask.to_bytes());
        bytes[2..4].copy_from_slice(&self.mode.to_bytes());
        bytes
    }
}

impl Codec<4> for RelayControl {
    fn from_bytes(bytes: &[u8]) -> ParseResult<Self>
    where
        Self: Sized,
    {
        RelayControl::from_bytes(bytes)
    }

    fn to_bytes_const(&self) -> [u8; 4] {
        RelayControl::to_bytes(self)
    }
}

impl Default for RelayControl {
    fn default() -> Self {
        RelayControl::new()
    }
}

/// 客户自定义字符串
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct CustomString(Vec<u8>);

impl ToParamSetUnit for CustomString {
    fn to_param_type(&self) -> ParamSetUnit {
        ParamSetUnit {
            item: ParamType::UserString(self.clone()),
            data_type: 20,
            data_len: self.0.len() as u8,
        }
    }
}

impl CustomString {
    pub fn from_bytes(bytes: &[u8], len: u8) -> ParseResult<Self> {
        if bytes.len() < len as usize {
            Err(ParseError::InsufficientData {
                field: "CustomString".to_string(),
                expected: len as usize,
                actual: bytes.len(),
            })
        } else {
            Ok(CustomString(bytes[..len as usize].to_vec()))
        }
    }

    pub fn from_cursor_bytes(cursor: &mut Cursor<&[u8]>, read_len: u8) -> ParseResult<Self> {
        let remaining = cursor.get_ref().len() - cursor.position() as usize;
        if read_len as usize > remaining {
            Err(ParseError::InsufficientData {
                field: "CustomString".to_string(),
                expected: read_len as usize,
                actual: remaining,
            })
        } else {
            let mut bytes = vec![0; read_len as usize];
            cursor
                .read_exact(&mut bytes)
                .map_err(|e| ParseError::InvalidDataFormat {
                    data_type: 0,
                    reason: format!("Failed to read custom string: {e}"),
                })?;
            Ok(CustomString(bytes))
        }
    }

    pub fn from_str(s: &str) -> ParseResult<Self> {
        if s.len() > 255 {
            Err(ParseError::InvalidDataFormat {
                data_type: 0,
                reason: "string length exceeds maximum allowed".to_string(),
            })
        } else {
            Ok(CustomString(s.as_bytes().to_vec()))
        }
    }

    pub fn get_bytes(&self) -> &[u8] {
        &self.0
    }

    pub fn to_bytes(&self) -> Vec<u8> {
        self.0.clone()
    }

    pub fn get_len(&self) -> usize {
        self.0.len()
    }

    pub fn get_string(&self) -> String {
        String::from_utf8_lossy(&self.0).to_string()
    }
}

